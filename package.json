{
  "name": "digital-terrarium",
  "version": "1.4.0",
  "description": "A GPU-assisted electronic aquarium beneath your desktop windows.",
  "main": "electron-main.js",
  "scripts": {
    "build:bridge": "go build -trimpath -o bin/digital-terrarium .",
    "start": "npm run build:bridge && electron . --terrarium",
    "serve": "npm run build:bridge && ./bin/digital-terrarium",
    "test": "go test ./... && node --test ecology.test.mjs agent-activity.test.mjs agent-courier.test.mjs",
    "agent:demo": "node scripts/agent-activity.mjs demo",
    "test:scene": "npm run build:bridge && electron scripts/scene-check.cjs"
  },
  "license": "ISC",
  "dependencies": {},
  "devDependencies": {
    "electron": "^44.2.0"
  }
}
